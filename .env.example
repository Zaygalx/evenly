# Evenly environment variables.
# Copy these names into Vercel > Project > Settings > Environment Variables.
# NEVER commit real values, and never paste a private key into chat.

# Phase 2 - Walrus Memory (MemWal). Account + delegate key from your Walrus Memory account.
MEMWAL_ACCOUNT_ID=
MEMWAL_DELEGATE_KEY=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
MEMWAL_SERVER_URL=https://api.memory.walrus.xyz

# Phase 3 - Tatum (Sui gRPC streaming + REST). From your Tatum dashboard.
TATUM_API_KEY=
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# App
NEXT_PUBLIC_APP_NAME=Evenly
